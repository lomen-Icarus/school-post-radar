# ---- Telegram ----
BOT_TOKEN=123456:ABC-DEF...            # токен от @BotFather
ADMIN_IDS=123456789                     # Telegram user id администраторов через запятую (/scan_now, /resolve, /stats, /check)
ALLOWED_USER_IDS=                       # пусто = подписаться может любой; иначе список id через запятую

# ---- VK ----
VK_ACCESS_TOKEN=vk1.a....               # СЕРВИСНЫЙ ключ доступа приложения (см. README, раздел «Токен VK»)
VK_API_VERSION=5.199
VK_API_BASE=https://api.vk.ru/method/   # официальный сервер API; api.vk.com тоже отвечает
VK_RPS=3                                # запросов в секунду (сервисный ключ: от 5, пользовательский токен: 3)
VK_USE_EXECUTE=0                        # 1 — пакетировать wall.get через execute (только для ПОЛЬЗОВАТЕЛЬСКОГО токена)
VK_EXECUTE_BATCH=10                     # сообществ в одном вызове execute (максимум 25)

# ---- Claude (классификация постов) ----
ANTHROPIC_API_KEY=sk-ant-...            # если пусто — работает только фильтр по ключевым словам
CLASSIFIER_MODEL=claude-opus-5          # дешевле: claude-sonnet-5, claude-haiku-4-5 (для Haiku effort не применяется)
CLASSIFIER_EFFORT=low                   # low | medium | high | xhigh | max
CLASSIFIER_FALLBACKS=1                  # серверный fallback при отказе модели (beta)
CLASSIFIER_CONCURRENCY=3

# ---- Расписание сканирования (время в TIMEZONE) ----
TIMEZONE=Europe/Moscow
SCAN_WINDOWS=08:00-12:45,17:00-20:45    # окна, внутри которых нагрузка размазывается по всем сообществам
SCAN_TICK_SECONDS=300                   # шаг сканирования
CATCHUP_MAX_PER_TICK=60                 # сообществ за тик при догоне пропущенного окна
LOOKBACK_HOURS=48                       # глубина просмотра ленты
MONITOR_SCOPE=all                       # all = все найденные группы (и кандидаты); official = только подтверждённые (59)
WALL_COUNT=20                           # сколько последних постов запрашивать у группы
MIN_CONFIDENCE=0.6                      # порог уверенности классификатора для уведомления
DEFAULT_DIGEST_TIMES=13:00,21:00

# ---- Хранилище ----
DB_PATH=data/radar.sqlite
REGISTRY_SEED_PATH=data/registry_seed.sqlite
LOG_LEVEL=INFO
